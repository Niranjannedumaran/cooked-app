# Optional override for a hosted waitlist endpoint. Vercel uses /api/waitlist by default.
VITE_WAITLIST_ENDPOINT=

# Add these in Vercel Project Settings → Environment Variables. Never expose them as VITE_ variables.
RESEND_API_KEY=
# Optional. Leave blank to use Resend's test sender, which can send only to
# the Resend account owner's verified email address.
WAITLIST_FROM_EMAIL=
WAITLIST_RECIPIENT=niranjanpersonal1@gmail.com
